# ==============================================================================
# ORCA Frontend Environment Variables (.env.example)
# Note: VITE_* variables are embedded into the client build and are publicly visible.
# ==============================================================================

# API Base URL (must point to shared parent domain in development)
VITE_API_BASE_URL=http://api.localtest.me:8000/api/v1

# Cloudflare Turnstile Site Key (Cloudflare testing key; always passes in dev: https://developers.cloudflare.com/turnstile/frequently-asked-questions/)
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Map Configuration: pmtiles | maptiler
VITE_MAP_STYLE=pmtiles

# MapTiler API Key (optional; get free key at https://www.maptiler.com)
VITE_MAPTILER_KEY=

# PMTiles Vector Basemap URL (optional keyless self-hosted vector map)
VITE_PMTILES_URL=https://assets.orca.example/tiles/india-coast.pmtiles

# Sentry DSN for frontend error telemetry (optional; get from https://sentry.io)
VITE_SENTRY_DSN=

# Environment Identifier: development | production | test
VITE_ENV=development
