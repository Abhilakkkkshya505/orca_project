# ==============================================================================
# ORCA Frontend Environment Variables (.env.example)
# Note: VITE_* variables are embedded in the client build and are publicly visible.
# ==============================================================================

# API Base URL (must point to shared parent domain in development)
VITE_API_BASE_URL=http://api.localtest.me:8000/api/v1

# Cloudflare Turnstile Site Key
# Testing Dummy Site Key (Always Passes in Dev): 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Observability
VITE_SENTRY_DSN=

# Environment Identifier
VITE_ENV=development

# PMTiles Vector Basemap URL
VITE_PMTILES_URL=https://assets.orca.example/tiles/india-coast.pmtiles
