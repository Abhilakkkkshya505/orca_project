# ==============================================================================
# ORCA Backend Environment Variables (.env.example)
# ==============================================================================

# ---------- REQUIRED TO RUN LOCALLY (No API keys needed) ----------
# Core environment mode: local | development | production | test
ENVIRONMENT=local
# Django secret key (min 50 chars in production; dummy key fine for local dev)
SECRET_KEY=orca-insecure-development-secret-key-replace-in-production-min-50-chars-long
# Debug flag (True for local/dev, False in production)
DEBUG=True

# Host and Domain Bindings (localtest.me resolves to 127.0.0.1)
ALLOWED_HOSTS=api.localtest.me,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://app.localtest.me:5173,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://app.localtest.me:5173,http://localhost:5173
COOKIE_DOMAIN=.localtest.me
FRONTEND_URL=http://app.localtest.me:5173

# Database & Cache (PostGIS and Redis)
# Host connection:
DATABASE_URL=postgis://orca:orca_dev_password@localhost:5432/orca
# Inside Docker containers (docker-compose overrides these to db and redis):
# DATABASE_URL=postgis://orca:orca_dev_password@db:5432/orca
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# Risk Engine Operational Toggle
RISK_OUTPUT_ENABLED=true

# Development Bypass Access (Turnstile/JWT bypass in local mode; REFUSES to start if True in production)
DEV_BYPASS_ACCESS=true

# Cloudflare Turnstile Secret Key (Cloudflare documented testing key; always passes in dev: https://developers.cloudflare.com/turnstile/frequently-asked-questions/)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Email Configuration (Console backend logs emails to stdout/terminal in dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=ORCA Marine Safety <alerts@orca.example>

# ---------- DATA PROVIDERS ----------
# Open-Meteo commercial API key (optional; free non-commercial tier requires NO key: https://open-meteo.com)
OPEN_METEO_API_KEY=

# Copernicus Marine Service credentials (recommended; free account at https://marine.copernicus.eu)
COPERNICUSMARINE_USERNAME=
COPERNICUSMARINE_PASSWORD=

# Global Fishing Watch API v3 token (recommended; free token for non-commercial research: https://globalfishingwatch.org/our-apis/tokens)
GFW_API_ACCESS_TOKEN=

# ECMWF Climate Data Store API key (optional; for ERA5 wave reanalysis: https://cds.climate.copernicus.eu/api-how-to)
CDS_API_URL=
CDS_API_KEY=

# NOAA CoastWatch ERDDAP endpoint (no key required: https://coastwatch.pfeg.noaa.gov/erddap)
NOAA_ERDDAP_BASE_URL=https://coastwatch.pfeg.noaa.gov/erddap

# Global Disaster Alert and Coordination System (no key required: https://www.gdacs.org)
GDACS_BASE_URL=https://www.gdacs.org/xml/rss.xml

# ---------- LLM PROVIDERS ----------
# Active LLM provider: template | gemini | anthropic (default 'template' needs no key and guarantees deterministic output)
LLM_PROVIDER=template

# Google Gemini API key and model (optional; get from Google AI Studio: https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Anthropic Claude API key and model (optional; get from https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Daily LLM Token Budget (hard cap enforced by orchestrator)
LLM_DAILY_TOKEN_BUDGET=200000

# ---------- OBSERVABILITY ----------
# Sentry DSN for backend error tracking (optional; get from https://sentry.io)
SENTRY_DSN=
