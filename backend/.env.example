# ==============================================================================
# ORCA Backend Environment Variables (.env.example)
# ==============================================================================

# Core Django Settings
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=orca-insecure-development-secret-key-replace-in-production-min-50-chars-long
ENVIRONMENT=local
DEBUG=True

# Network & Host Binding
ALLOWED_HOSTS=api.localtest.me,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://app.localtest.me:5173,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://app.localtest.me:5173,http://localhost:5173
COOKIE_DOMAIN=.localtest.me
FRONTEND_URL=http://app.localtest.me:5173

# Database & Cache Connections
# Use postgis:// dialect for GeoDjango
DATABASE_URL=postgis://orca:orca_dev_password@localhost:5432/orca
# Use when running inside Docker container:
# DATABASE_URL=postgis://orca:orca_dev_password@db:5432/orca
DATABASE_MIGRATE_URL=postgis://orca_migrate:orca_migrate_password@localhost:5432/orca

REDIS_URL=redis://localhost:6379/0
# Inside Docker: redis://redis:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
# Inside Docker: redis://redis:6379/1

# Security & Cloudflare Integration
TRUST_CF_HEADERS=false
# Cloudflare Turnstile Testing Dummy Secret Key (Always Passes in Dev)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
CF_ACCESS_TEAM_DOMAIN=example-team.cloudflareaccess.com
CF_ACCESS_AUD=dummy-cf-access-audience-tag-000000000000

# Cloudflare R2 Object Storage
R2_ENDPOINT_URL=https://dummy-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=dummy_r2_access_key_id
R2_SECRET_ACCESS_KEY=dummy_r2_secret_access_key
R2_BUCKET_DATA=orca-data-dev
R2_BUCKET_BACKUPS=orca-backups-dev

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=dummy_smtp_password
DEFAULT_FROM_EMAIL=ORCA Marine Safety <alerts@orca.example>

# Observability
SENTRY_DSN=

# LLM Providers (template, anthropic, gemini)
# Default 'template' provider needs no API keys and guarantees deterministic offline operation
LLM_PROVIDER=template
LLM_MODEL=claude-3-5-sonnet-latest
LLM_API_KEY=
LLM_DAILY_TOKEN_BUDGET=100000

# Data Providers
# Open-Meteo free tier requires no API key for non-commercial use
OPEN_METEO_API_KEY=
COPERNICUSMARINE_USERNAME=
COPERNICUSMARINE_PASSWORD=
EARTHDATA_TOKEN=

# Geographic Coverage: Indian Coast Bounding Box (min_lon,min_lat,max_lon,max_lat)
COVERAGE_BBOX=68.0,6.0,89.0,24.0

# Safety Kill-Switch
RISK_OUTPUT_ENABLED=true

# Demo Data Seeding
DEMO_PASSWORD=OrcaDemoUser2026!
